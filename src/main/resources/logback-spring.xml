<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ========== 通用 Pattern 定义（避免重复） ========== -->
    <property name="CONSOLE_PATTERN" value="%d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>
    <property name="FILE_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n"/>

    <!-- ========== 控制台输出：仅 INFO，干净的业务/启动日志 ========== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
    </appender>

    <!-- ========== SQL 文件输出：按天滚动，保留 7 天 ========== -->
    <appender name="SQL_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/project-sql.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/project-sql.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========== API 业务文件输出：大小+时间双策略滚动 ========== -->
    <appender name="API_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/project-api.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- 归档文件命名：project-api.2026-05-31.0.log -->
            <fileNamePattern>logs/project-api.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- 单个文件上限 10MB -->
            <maxFileSize>10MB</maxFileSize>
            <!-- 保留 7 天 -->
            <maxHistory>7</maxHistory>
            <!-- 总上限 1GB -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${FILE_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ========== Logger 路由规则 ========== -->

    <!--
        MyBatis / MyBatis-Plus 所有 DEBUG 日志 → SQL_FILE 独享。
        additivity="false" 切断向 root → CONSOLE 的传递，控制台保持干净。
    -->
    <logger name="org.apache.ibatis" level="DEBUG" additivity="false">
        <appender-ref ref="SQL_FILE"/>
    </logger>
    <logger name="org.mybatis" level="DEBUG" additivity="false">
        <appender-ref ref="SQL_FILE"/>
    </logger>
    <logger name="com.baomidou.mybatisplus" level="DEBUG" additivity="false">
        <appender-ref ref="SQL_FILE"/>
    </logger>

    <!--
        Mapper 包 DEBUG 日志（SQL 语句、参数绑定、结果映射） → SQL_FILE。
    -->
    <logger name="com.unibridge.backend.infrastructure.persistence.mapper" level="DEBUG" additivity="false">
        <appender-ref ref="SQL_FILE"/>
    </logger>

    <!--
        项目业务包：INFO 及以上 → CONSOLE + API_FILE（双写）。
        additivity="false" 防止重复进入 root。
        DEBUG/TRACE 级别的框架日志也定向到 SQL_FILE。
    -->
    <logger name="com.unibridge.backend" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="API_FILE"/>
        <appender-ref ref="SQL_FILE"/>
    </logger>

    <!--
        Spring / Tomcat / HikariCP 等框架 INFO 日志只进控制台。
    -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.apache.catalina" level="INFO"/>
    <logger name="com.zaxxer.hikari" level="INFO"/>

    <!-- ========== Root：所有未匹配的日志默认 INFO 进控制台 ========== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
