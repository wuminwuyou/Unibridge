# ==============================================================
# UnibridgeBackend Docker Compose 环境变量
# 复制为 .env 后按需修改，.env 不会被提交到 Git
# ==============================================================

# MySQL root 密码（默认 111111）
MYSQL_ROOT_PASSWORD=111111

# Redis 密码（默认 f31ae273df314d）
REDIS_PASSWORD=f31ae273df314d

# 宿主机端口映射
MYSQL_PORT=3306
REDIS_PORT=6379
APP_PORT=8081

# 应用镜像标签
APP_IMAGE_TAG=latest

# 上传文件生成外部访问 URL 时使用的服务根地址
FILE_PUBLIC_BASE_URL=http://localhost:8081

# JVM 参数，可按服务器内存调整
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+UseG1GC
